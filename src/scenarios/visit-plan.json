{
  "module": "visit-plan",
  "label": "18 · Visit Plan",
  "surface": [
    {
      "endpoint": "GET /api/v1/app/visitplan/territories",
      "expect": [
        200,
        401
      ]
    },
    {
      "endpoint": "GET /api/v1/app/visitplan/reporting-places",
      "expect": [
        200,
        401
      ],
      "note": "terrId is an optional filter; omitting it returns the whole set"
    },
    {
      "endpoint": "GET /api/v1/app/visitplan/doctors",
      "expect": [
        200,
        401
      ],
      "note": "terrId is an optional filter; omitting it returns the whole set"
    },
    {
      "endpoint": "GET /api/v1/app/visitplan/chambers",
      "expect": [
        200,
        401
      ],
      "note": "terrId is an optional filter; omitting it returns the whole set"
    },
    {
      "endpoint": "GET /api/v1/app/visitplan",
      "expect": [
        200,
        401
      ],
      "note": "list + AM inbox via pendingForMe"
    },
    {
      "endpoint": "GET /api/v1/app/visitplan/{id}",
      "expect": [
        200,
        401,
        404
      ]
    },
    {
      "endpoint": "GET /api/v1/app/visitplan/by-date",
      "expect": [
        200,
        401
      ],
      "note": "serves the approved version"
    },
    {
      "endpoint": "POST /api/v1/app/visitplan",
      "expect": [
        200,
        400,
        401
      ]
    },
    {
      "endpoint": "PUT /api/v1/app/visitplan/{id}",
      "expect": [
        200,
        400,
        401,
        403,
        404
      ],
      "note": "403 when the plan is not yours"
    },
    {
      "endpoint": "PUT /api/v1/app/visitplan/{id}/approval",
      "expect": [
        200,
        400,
        401,
        403,
        404
      ],
      "note": "403 when you are not the pending approver"
    }
  ],
  "scenarios": [
    {
      "id": "vp.happy.submit-approve-bydate",
      "module": "visit-plan",
      "path": "happy",
      "title": "Build a month, AM approves, by-date serves it",
      "description": "The full chain: three cascading lookups, submit the month, AM approves, then confirm get-plan-by-date returns the day's visits from the approved version.",
      "requires": [
        "mio",
        "am"
      ],
      "writes": true,
      "inputs": [
        {
          "name": "year",
          "label": "Plan year",
          "type": "number",
          "default": "{{nextMonthYear}}",
          "hint": "field users can only plan a month later than the current one"
        },
        {
          "name": "month",
          "label": "Plan month",
          "type": "select",
          "default": "{{nextMonth}}",
          "hint": "one plan per employee + month",
          "options": [
            {
              "value": 1,
              "label": "January"
            },
            {
              "value": 2,
              "label": "February"
            },
            {
              "value": 3,
              "label": "March"
            },
            {
              "value": 4,
              "label": "April"
            },
            {
              "value": 5,
              "label": "May"
            },
            {
              "value": 6,
              "label": "June"
            },
            {
              "value": 7,
              "label": "July"
            },
            {
              "value": 8,
              "label": "August"
            },
            {
              "value": 9,
              "label": "September"
            },
            {
              "value": 10,
              "label": "October"
            },
            {
              "value": 11,
              "label": "November"
            },
            {
              "value": 12,
              "label": "December"
            }
          ]
        }
      ],
      "steps": [
        {
          "id": "territories",
          "title": "Territory picker",
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan/territories",
            "as": "mio",
            "mobileHeader": true
          },
          "capture": {
            "terrId": "data[0].code"
          },
          "expect": {
            "httpStatus": 200,
            "envelopeStatusCode": 200,
            "nonEmpty": "data"
          },
          "critical": true
        },
        {
          "id": "reporting-places",
          "title": "Approved reporting places across the employee's territories",
          "note": "Approved only — a pending reporting-place request cannot be planned against.",
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan/reporting-places",
            "as": "mio",
            "mobileHeader": true
          },
          "capture": {
            "rpId": "data[0].id"
          },
          "expect": {
            "envelopeStatusCode": 200,
            "nonEmpty": "data"
          },
          "critical": true
        },
        {
          "id": "doctors",
          "title": "Doctors across the employee's territories",
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan/doctors",
            "as": "mio",
            "mobileHeader": true
          },
          "capture": {
            "doctorCode": "data[0].code"
          },
          "expect": {
            "envelopeStatusCode": 200,
            "nonEmpty": "data"
          },
          "critical": true
        },
        {
          "id": "chambers",
          "title": "That doctor's chambers",
          "note": "The chamber must belong to the chosen doctor AND sit in one of the employee's territories.",
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan/chambers?doctorCode={{doctorCode}}",
            "as": "mio",
            "mobileHeader": true
          },
          "capture": {
            "chamberId": "data[0].id"
          },
          "expect": {
            "envelopeStatusCode": 200,
            "nonEmpty": "data"
          },
          "critical": true
        },
        {
          "id": "submit",
          "title": "Submit the month",
          "note": "A plan is unique per employee + month. Field users can only create a month later than the current one.",
          "request": {
            "method": "POST",
            "path": "/api/v1/app/visitplan",
            "as": "mio",
            "mobileHeader": true,
            "bodyFrom": "visitPlanMonth",
            "bodyArgs": {
              "year": "{{year}}",
              "month": "{{month}}",
              "dates": 3,
              "perDate": 1,
              "pool": [
                {
                  "chamberId": "{{chamberId}}",
                  "doctorCode": "{{doctorCode}}"
                }
              ],
              "reportingPlaceId": "{{rpId}}"
            }
          },
          "capture": {
            "planId": "data.id",
            "planStatus": "data.status",
            "planVersion": "data.currentVersion"
          },
          "expect": {
            "httpStatus": 200,
            "envelopeStatusCode": 200
          },
          "critical": true
        },
        {
          "id": "am-inbox",
          "title": "AM inbox — pending for me",
          "note": "Empty here means the PGroup has no APPROVAL_PROCESS row for OperationType 5, so the plan auto-approved.",
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan?pendingForMe=true&page=1&pageSize=20",
            "as": "am",
            "mobileHeader": true
          },
          "expect": {
            "envelopeStatusCode": 200
          }
        },
        {
          "id": "detail",
          "title": "Open the plan calendar",
          "requiresVars": [
            "planId"
          ],
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan/{{planId}}",
            "as": "mio",
            "mobileHeader": true
          },
          "expect": {
            "envelopeStatusCode": 200
          }
        },
        {
          "id": "approve",
          "title": "AM approves",
          "requiresVars": [
            "planId"
          ],
          "request": {
            "method": "PUT",
            "path": "/api/v1/app/visitplan/{{planId}}/approval",
            "as": "am",
            "mobileHeader": true,
            "body": {
              "status": 1
            }
          },
          "capture": {
            "approvedVersion": "data.approvedVersion"
          },
          "expect": {
            "envelopeStatusCode": 200
          },
          "note": "Task 22: approval now runs every configured APPROVAL_PROCESS step in sequence. If the environment has an Admin step after AM, this approve leaves the plan Pending and by-date stays empty until an admin approves from the web portal."
        },
        {
          "id": "by-date",
          "title": "by-date serves the approved version",
          "note": "by-date always reads APPROVED_VERSION, never a pending edit.",
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan/by-date?date={{firstOfMonth}}",
            "as": "mio",
            "mobileHeader": true
          },
          "expect": {
            "envelopeStatusCode": 200
          }
        }
      ]
    },
    {
      "id": "vp.average.amend-and-duplicate",
      "module": "visit-plan",
      "path": "average",
      "title": "Duplicate month, then amend back to Pending",
      "description": "The two things that actually happen day to day: someone re-submits a month that already exists, and someone amends an approved plan — which returns it to Pending while by-date keeps serving the last approved version.",
      "requires": [
        "mio"
      ],
      "writes": true,
      "inputs": [
        {
          "name": "year",
          "label": "Plan year",
          "type": "number",
          "default": "{{nextMonthYear}}",
          "hint": "field users can only plan a month later than the current one"
        },
        {
          "name": "month",
          "label": "Plan month",
          "type": "select",
          "default": "{{nextMonth}}",
          "hint": "one plan per employee + month",
          "options": [
            {
              "value": 1,
              "label": "January"
            },
            {
              "value": 2,
              "label": "February"
            },
            {
              "value": 3,
              "label": "March"
            },
            {
              "value": 4,
              "label": "April"
            },
            {
              "value": 5,
              "label": "May"
            },
            {
              "value": 6,
              "label": "June"
            },
            {
              "value": 7,
              "label": "July"
            },
            {
              "value": 8,
              "label": "August"
            },
            {
              "value": 9,
              "label": "September"
            },
            {
              "value": 10,
              "label": "October"
            },
            {
              "value": 11,
              "label": "November"
            },
            {
              "value": 12,
              "label": "December"
            }
          ]
        }
      ],
      "steps": [
        {
          "id": "territories",
          "title": "Territory picker",
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan/territories",
            "as": "mio",
            "mobileHeader": true
          },
          "capture": {
            "terrId": "data[0].code"
          },
          "expect": {
            "envelopeStatusCode": 200,
            "nonEmpty": "data"
          },
          "critical": true
        },
        {
          "id": "my-plans",
          "title": "My plans this month",
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan?year={{year}}&month={{month}}&page=1&pageSize=20",
            "as": "mio",
            "mobileHeader": true
          },
          "capture": {
            "existingPlanId": "data.items[0].id"
          },
          "expect": {
            "envelopeStatusCode": 200
          }
        },
        {
          "id": "reporting-places",
          "title": "Approved reporting places",
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan/reporting-places",
            "as": "mio",
            "mobileHeader": true
          },
          "capture": {
            "rpId": "data[0].id"
          },
          "expect": {
            "envelopeStatusCode": 200,
            "nonEmpty": "data"
          },
          "critical": true
        },
        {
          "id": "doctors",
          "title": "Doctors",
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan/doctors",
            "as": "mio",
            "mobileHeader": true
          },
          "capture": {
            "doctorCode": "data[0].code"
          },
          "expect": {
            "envelopeStatusCode": 200,
            "nonEmpty": "data"
          },
          "critical": true
        },
        {
          "id": "chambers",
          "title": "Chambers",
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan/chambers?doctorCode={{doctorCode}}",
            "as": "mio",
            "mobileHeader": true
          },
          "capture": {
            "chamberId": "data[0].id"
          },
          "expect": {
            "envelopeStatusCode": 200,
            "nonEmpty": "data"
          },
          "critical": true
        },
        {
          "id": "duplicate-month",
          "title": "400 — a plan already exists for this month",
          "note": "Only meaningful once a plan exists for this employee, territory and month. On a clean database this step will pass with 200 instead.",
          "request": {
            "method": "POST",
            "path": "/api/v1/app/visitplan",
            "as": "mio",
            "mobileHeader": true,
            "bodyFrom": "visitPlanMonth",
            "bodyArgs": {
              "year": "{{year}}",
              "month": "{{month}}",
              "dates": 2,
              "perDate": 1,
              "pool": [
                {
                  "chamberId": "{{chamberId}}",
                  "doctorCode": "{{doctorCode}}"
                }
              ],
              "reportingPlaceId": "{{rpId}}"
            }
          },
          "expect": {
            "httpStatus": 200,
            "envelopeStatus": "ValidationError",
            "envelopeStatusCode": 400
          }
        },
        {
          "id": "amend",
          "title": "Amend the existing plan → Pending",
          "note": "An MIO amend always returns the whole plan to Pending and creates a new approval row.",
          "requiresVars": [
            "existingPlanId"
          ],
          "request": {
            "method": "PUT",
            "path": "/api/v1/app/visitplan/{{existingPlanId}}",
            "as": "mio",
            "mobileHeader": true,
            "bodyFrom": "visitPlanMonth",
            "bodyArgs": {
              "year": "{{year}}",
              "month": "{{month}}",
              "dates": 2,
              "perDate": 1,
              "pool": [
                {
                  "chamberId": "{{chamberId}}",
                  "doctorCode": "{{doctorCode}}"
                }
              ],
              "reportingPlaceId": "{{rpId}}"
            }
          },
          "expect": {
            "envelopeStatusCode": 200
          }
        },
        {
          "id": "by-date-after-amend",
          "title": "by-date still serves the approved version",
          "note": "The amend above is pending, so the day's visits must not change.",
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan/by-date?date={{firstOfMonth}}",
            "as": "mio",
            "mobileHeader": true
          },
          "expect": {
            "envelopeStatusCode": 200
          }
        }
      ]
    },
    {
      "id": "vp.average.amend-then-approve",
      "module": "visit-plan",
      "path": "average",
      "title": "MIO amends an approved plan, AM approves the new version",
      "description": "The loop that happens every month: a plan already exists, the MIO changes it, that returns the whole plan to Pending at a new version, and the AM approves it. Proves the version actually moved and the status actually changed, not just that nothing errored.",
      "requires": [
        "mio",
        "am"
      ],
      "writes": true,
      "inputs": [
        {
          "name": "year",
          "label": "Plan year",
          "type": "number",
          "default": "{{nextMonthYear}}",
          "hint": "field users can only plan a month later than the current one"
        },
        {
          "name": "month",
          "label": "Plan month",
          "type": "select",
          "default": "{{nextMonth}}",
          "hint": "one plan per employee + month",
          "options": [
            {
              "value": 1,
              "label": "January"
            },
            {
              "value": 2,
              "label": "February"
            },
            {
              "value": 3,
              "label": "March"
            },
            {
              "value": 4,
              "label": "April"
            },
            {
              "value": 5,
              "label": "May"
            },
            {
              "value": 6,
              "label": "June"
            },
            {
              "value": 7,
              "label": "July"
            },
            {
              "value": 8,
              "label": "August"
            },
            {
              "value": 9,
              "label": "September"
            },
            {
              "value": 10,
              "label": "October"
            },
            {
              "value": 11,
              "label": "November"
            },
            {
              "value": 12,
              "label": "December"
            }
          ]
        }
      ],
      "steps": [
        {
          "id": "territories",
          "title": "Territory picker",
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan/territories",
            "as": "mio",
            "mobileHeader": true
          },
          "capture": {
            "terrId": "data[0].code"
          },
          "expect": {
            "envelopeStatusCode": 200,
            "nonEmpty": "data"
          },
          "critical": true
        },
        {
          "id": "reporting-places",
          "title": "Approved reporting places",
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan/reporting-places",
            "as": "mio",
            "mobileHeader": true
          },
          "capture": {
            "rpId": "data[0].id",
            "rpId2": "data[1].id"
          },
          "expect": {
            "envelopeStatusCode": 200,
            "nonEmpty": "data"
          },
          "critical": true,
          "note": "A second approved place is captured - the amend moves the whole month onto it. The scenario needs at least two approved reporting places in scope."
        },
        {
          "id": "doctors",
          "title": "Doctors in scope",
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan/doctors",
            "as": "mio",
            "mobileHeader": true
          },
          "capture": {
            "doctorCode": "data[0].code"
          },
          "expect": {
            "envelopeStatusCode": 200,
            "nonEmpty": "data"
          },
          "critical": true
        },
        {
          "id": "chambers",
          "title": "That doctor's chambers",
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan/chambers?doctorCode={{doctorCode}}",
            "as": "mio",
            "mobileHeader": true
          },
          "capture": {
            "chamberId": "data[0].id"
          },
          "expect": {
            "envelopeStatusCode": 200,
            "nonEmpty": "data"
          },
          "critical": true
        },
        {
          "id": "find-existing",
          "title": "Is there already a plan for this month?",
          "note": "The scenario needs an existing plan to amend; if none is found the next step creates one.",
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan?year={{year}}&month={{month}}&page=1&pageSize=20",
            "as": "mio",
            "mobileHeader": true
          },
          "capture": {
            "planId": "data.items[0].id",
            "startVersion": "data.items[0].currentVersion"
          },
          "expect": {
            "envelopeStatusCode": 200
          }
        },
        {
          "id": "seed-plan",
          "title": "No plan yet — create one to amend",
          "note": "Skipped when the month already has a plan, so the scenario is safe to re-run.",
          "skipIfVars": [
            "planId"
          ],
          "request": {
            "method": "POST",
            "path": "/api/v1/app/visitplan",
            "as": "mio",
            "mobileHeader": true,
            "bodyFrom": "visitPlanMonth",
            "bodyArgs": {
              "year": "{{year}}",
              "month": "{{month}}",
              "dates": 2,
              "perDate": 1,
              "pool": [
                {
                  "chamberId": "{{chamberId}}",
                  "doctorCode": "{{doctorCode}}"
                }
              ],
              "reportingPlaceId": "{{rpId}}"
            }
          },
          "capture": {
            "planId": "data.id",
            "startVersion": "data.currentVersion"
          },
          "expect": {
            "envelopeStatusCode": 200
          }
        },
        {
          "id": "approve-seed",
          "title": "Make sure it starts Approved",
          "note": "An amend is only interesting from an approved plan - that is what returns to Pending. Task 22: approval now runs every configured APPROVAL_PROCESS step in sequence. If the environment has an Admin step after AM, this approve leaves the plan Pending and by-date stays empty until an admin approves from the web portal.",
          "requiresVars": [
            "planId"
          ],
          "request": {
            "method": "PUT",
            "path": "/api/v1/app/visitplan/{{planId}}/approval",
            "as": "am",
            "mobileHeader": true,
            "body": {
              "status": 1
            }
          },
          "expect": {
            "envelopeStatusCode": 200
          }
        },
        {
          "id": "before",
          "title": "Read the plan before the change",
          "requiresVars": [
            "planId"
          ],
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan/{{planId}}",
            "as": "mio",
            "mobileHeader": true
          },
          "capture": {
            "beforeVersion": "data.currentVersion",
            "beforeApproved": "data.approvedVersion",
            "beforeVisits": "data.totalVisits"
          },
          "expect": {
            "envelopeStatusCode": 200
          },
          "critical": true
        },
        {
          "id": "amend",
          "title": "MIO amends — more dates, more visits per date",
          "note": "A full replacement of the month, not a patch. Three dates at a DIFFERENT reporting place than the seed, so the amend is a real change: the seed's two dates at {{rpId}} become three at {{rpId2}}. One reporting place per date is enforced server-side since task 22, so a date cannot stack two places.",
          "requiresVars": [
            "planId"
          ],
          "request": {
            "method": "PUT",
            "path": "/api/v1/app/visitplan/{{planId}}",
            "as": "mio",
            "mobileHeader": true,
            "bodyFrom": "visitPlanMonth",
            "bodyArgs": {
              "year": "{{year}}",
              "month": "{{month}}",
              "dates": 3,
              "perDate": 1,
              "pool": [
                {
                  "chamberId": "{{chamberId}}",
                  "doctorCode": "{{doctorCode}}"
                }
              ],
              "reportingPlaceId": "{{rpId2}}"
            }
          },
          "capture": {
            "amendedVersion": "data.currentVersion",
            "amendedVisits": "data.totalVisits"
          },
          "expect": {
            "envelopeStatusCode": 200,
            "equals": {
              "data.status": 2
            }
          },
          "critical": true
        },
        {
          "id": "bydate-unchanged",
          "title": "by-date still serves the OLD approved version",
          "note": "The amend is pending, so the field force must not see it yet.",
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan/by-date?date={{firstOfMonth}}",
            "as": "mio",
            "mobileHeader": true
          },
          "expect": {
            "envelopeStatusCode": 200,
            "equals": {
              "data.version": "{{beforeApproved}}"
            }
          }
        },
        {
          "id": "am-inbox",
          "title": "It is waiting in the AM's inbox",
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan?pendingForMe=true&page=1&pageSize=20",
            "as": "am",
            "mobileHeader": true
          },
          "expect": {
            "envelopeStatusCode": 200
          }
        },
        {
          "id": "am-approves",
          "title": "AM approves the amended version",
          "requiresVars": [
            "planId"
          ],
          "request": {
            "method": "PUT",
            "path": "/api/v1/app/visitplan/{{planId}}/approval",
            "as": "am",
            "mobileHeader": true,
            "body": {
              "status": 1
            }
          },
          "expect": {
            "envelopeStatusCode": 200,
            "equals": {
              "data.status": 1,
              "data.approvedVersion": "{{amendedVersion}}"
            }
          },
          "critical": true,
          "note": "Task 22: approval now runs every configured APPROVAL_PROCESS step in sequence. If the environment has an Admin step after AM, this approve leaves the plan Pending and by-date stays empty until an admin approves from the web portal."
        },
        {
          "id": "bydate-updated",
          "title": "by-date now serves the amended version",
          "note": "The whole point of the loop: approval is what makes an edit visible to the field.",
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan/by-date?date={{firstOfMonth}}",
            "as": "mio",
            "mobileHeader": true
          },
          "expect": {
            "envelopeStatusCode": 200,
            "equals": {
              "data.version": "{{amendedVersion}}"
            }
          }
        }
      ]
    },
    {
      "id": "vp.average.am-submit-admin-approve",
      "module": "visit-plan",
      "path": "average",
      "title": "AM submits their own plan, an admin approves it",
      "description": "The chain an AM's own plan follows. An AM has no line manager inside this module, so their plan routes straight to the Admin step - which has no managerId and therefore never appears in anyone's mobile inbox. The admin half is deliberately decided on the WEB endpoint, because that is the only surface an Admin step can be decided from. Proves the plan stays Pending after submission and only becomes Approved once the admin acts, and that by-date withholds it in between.",
      "requires": [
        "am",
        "admin"
      ],
      "writes": true,
      "inputs": [
        {
          "name": "year",
          "label": "Plan year",
          "type": "number",
          "default": "{{nextMonthYear}}",
          "hint": "field users can only plan a month later than the current one"
        },
        {
          "name": "month",
          "label": "Plan month",
          "type": "select",
          "default": "{{nextMonth}}",
          "hint": "one plan per employee + month",
          "options": [
            {
              "value": 1,
              "label": "January"
            },
            {
              "value": 2,
              "label": "February"
            },
            {
              "value": 3,
              "label": "March"
            },
            {
              "value": 4,
              "label": "April"
            },
            {
              "value": 5,
              "label": "May"
            },
            {
              "value": 6,
              "label": "June"
            },
            {
              "value": 7,
              "label": "July"
            },
            {
              "value": 8,
              "label": "August"
            },
            {
              "value": 9,
              "label": "September"
            },
            {
              "value": 10,
              "label": "October"
            },
            {
              "value": 11,
              "label": "November"
            },
            {
              "value": 12,
              "label": "December"
            }
          ]
        }
      ],
      "steps": [
        {
          "id": "reporting-places",
          "title": "Approved reporting places across the AM's area",
          "note": "An AM is scoped to their whole area, not a single territory.",
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan/reporting-places",
            "as": "am",
            "mobileHeader": true
          },
          "capture": {
            "rpId": "data[0].id"
          },
          "expect": {
            "envelopeStatusCode": 200
          },
          "critical": true
        },
        {
          "id": "doctors",
          "title": "Doctors across the AM's area",
          "note": "Increment 5: no numeric id here - a doctor is identified by CODE.",
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan/doctors",
            "as": "am",
            "mobileHeader": true
          },
          "capture": {
            "doctorCode": "data[0].code"
          },
          "expect": {
            "envelopeStatusCode": 200
          },
          "critical": true
        },
        {
          "id": "chambers",
          "title": "That doctor's chambers, by code",
          "requiresVars": [
            "doctorCode"
          ],
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan/chambers?doctorCode={{doctorCode}}",
            "as": "am",
            "mobileHeader": true
          },
          "capture": {
            "chamberId": "data[0].id"
          },
          "expect": {
            "envelopeStatusCode": 200
          },
          "critical": true
        },
        {
          "id": "submit",
          "title": "AM submits their own month",
          "note": "The reporting place sits on the date (increment 5), not on each visit.",
          "requiresVars": [
            "rpId",
            "doctorCode",
            "chamberId"
          ],
          "request": {
            "method": "POST",
            "path": "/api/v1/app/visitplan",
            "as": "am",
            "mobileHeader": true,
            "bodyFrom": "visitPlanMonth",
            "bodyArgs": {
              "year": "{{year}}",
              "month": "{{month}}",
              "dates": 2,
              "perDate": 1,
              "reportingPlaceId": "{{rpId}}",
              "pool": [
                {
                  "doctorCode": "{{doctorCode}}",
                  "chamberId": "{{chamberId}}"
                }
              ]
            }
          },
          "capture": {
            "planId": "data.id",
            "submittedStatus": "data.status",
            "submittedApproved": "data.approvedVersion"
          },
          "expect": {
            "envelopeStatusCode": 200
          },
          "critical": true
        },
        {
          "id": "pending-on-admin",
          "title": "Still Pending — waiting on the Admin step",
          "note": "Status 2 = Pending. If this comes back 1 the environment has no Admin row configured for this PGroup, and the plan auto-approved instead.",
          "requiresVars": [
            "planId"
          ],
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan/{{planId}}",
            "as": "am",
            "mobileHeader": true
          },
          "expect": {
            "envelopeStatusCode": 200,
            "equals": {
              "data.status": 2
            }
          }
        },
        {
          "id": "not-in-am-inbox",
          "title": "An Admin step never reaches a mobile inbox",
          "note": "The step has no managerId, so it cannot match anyone's pendingForMe query. This is why the admin half has to happen on the web.",
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan?pendingForMe=true&page=1&pageSize=20",
            "as": "am",
            "mobileHeader": true
          },
          "expect": {
            "envelopeStatusCode": 200
          }
        },
        {
          "id": "bydate-withheld",
          "title": "by-date withholds a plan that has not finished approving",
          "note": "approvedVersion is only set by the FINAL step, so nothing reaches the field force yet.",
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan/by-date?date={{firstOfMonth}}",
            "as": "am",
            "mobileHeader": true
          },
          "expect": {
            "envelopeStatusCode": 200
          }
        },
        {
          "id": "admin-approves",
          "title": "Admin approves — on the WEB endpoint",
          "note": "Not /app/. An Admin step has no managerId, so it is decided through the web controller's admin-bypass path, gated by the VisitPlan.Approve permission.",
          "requiresVars": [
            "planId"
          ],
          "request": {
            "method": "PUT",
            "path": "/api/v1/visitplan/{{planId}}/approval",
            "as": "admin",
            "body": {
              "status": 1
            }
          },
          "expect": {
            "envelopeStatusCode": 200
          },
          "critical": true
        },
        {
          "id": "approved",
          "title": "Now Approved, and approvedVersion is set",
          "requiresVars": [
            "planId"
          ],
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan/{{planId}}",
            "as": "am",
            "mobileHeader": true
          },
          "expect": {
            "envelopeStatusCode": 200,
            "equals": {
              "data.status": 1
            }
          }
        },
        {
          "id": "bydate-served",
          "title": "by-date now serves the month",
          "note": "The whole point of the chain: only a fully approved plan reaches the field force.",
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan/by-date?date={{firstOfMonth}}",
            "as": "am",
            "mobileHeader": true
          },
          "expect": {
            "envelopeStatusCode": 200
          }
        }
      ]
    },
