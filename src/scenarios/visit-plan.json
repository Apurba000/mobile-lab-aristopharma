{
  "module": "visit-plan",
  "label": "18 · Visit Plan",
  "surface": [
    {
      "endpoint": "GET /api/v1/app/visitplan/territories",
      "expect": [
        200,
        401
      ]
    },
    {
      "endpoint": "GET /api/v1/app/visitplan/reporting-places",
      "expect": [
        200,
        400,
        401
      ],
      "note": "approved places only"
    },
    {
      "endpoint": "GET /api/v1/app/visitplan/doctors",
      "expect": [
        200,
        400,
        401
      ]
    },
    {
      "endpoint": "GET /api/v1/app/visitplan/chambers",
      "expect": [
        200,
        400,
        401
      ]
    },
    {
      "endpoint": "GET /api/v1/app/visitplan",
      "expect": [
        200,
        401
      ],
      "note": "list + AM inbox via pendingForMe"
    },
    {
      "endpoint": "GET /api/v1/app/visitplan/{id}",
      "expect": [
        200,
        401,
        404
      ]
    },
    {
      "endpoint": "GET /api/v1/app/visitplan/by-date",
      "expect": [
        200,
        401
      ],
      "note": "serves the approved version"
    },
    {
      "endpoint": "POST /api/v1/app/visitplan",
      "expect": [
        200,
        400,
        401
      ]
    },
    {
      "endpoint": "PUT /api/v1/app/visitplan/{id}",
      "expect": [
        200,
        400,
        401,
        403,
        404
      ],
      "note": "403 when the plan is not yours"
    },
    {
      "endpoint": "PUT /api/v1/app/visitplan/{id}/approval",
      "expect": [
        200,
        400,
        401,
        403,
        404
      ],
      "note": "403 when you are not the pending approver"
    }
  ],
  "scenarios": [
    {
      "id": "vp.happy.submit-approve-bydate",
      "module": "visit-plan",
      "path": "happy",
      "title": "Build a month, AM approves, by-date serves it",
      "description": "The full chain: three cascading lookups, submit the month, AM approves, then confirm get-plan-by-date returns the day's visits from the approved version.",
      "requires": [
        "mio",
        "am"
      ],
      "writes": true,
      "inputs": [
        {
          "name": "year",
          "label": "Plan year",
          "type": "number",
          "default": "{{year}}",
          "hint": "the plan's PLAN_YEAR"
        },
        {
          "name": "month",
          "label": "Plan month",
          "type": "select",
          "default": "{{month}}",
          "hint": "one plan per employee + territory + month",
          "options": [
            {
              "value": 1,
              "label": "January"
            },
            {
              "value": 2,
              "label": "February"
            },
            {
              "value": 3,
              "label": "March"
            },
            {
              "value": 4,
              "label": "April"
            },
            {
              "value": 5,
              "label": "May"
            },
            {
              "value": 6,
              "label": "June"
            },
            {
              "value": 7,
              "label": "July"
            },
            {
              "value": 8,
              "label": "August"
            },
            {
              "value": 9,
              "label": "September"
            },
            {
              "value": 10,
              "label": "October"
            },
            {
              "value": 11,
              "label": "November"
            },
            {
              "value": 12,
              "label": "December"
            }
          ]
        }
      ],
      "steps": [
        {
          "id": "territories",
          "title": "Territory picker",
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan/territories",
            "as": "mio",
            "mobileHeader": true
          },
          "capture": {
            "terrId": "data[0].value"
          },
          "expect": {
            "httpStatus": 200,
            "envelopeStatusCode": 200,
            "nonEmpty": "data"
          },
          "critical": true
        },
        {
          "id": "reporting-places",
          "title": "Approved reporting places in the territory",
          "note": "Approved only — a pending reporting-place request cannot be planned against.",
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan/reporting-places?terrId={{terrId}}",
            "as": "mio",
            "mobileHeader": true
          },
          "capture": {
            "rpId": "data[0].value"
          },
          "expect": {
            "envelopeStatusCode": 200,
            "nonEmpty": "data"
          },
          "critical": true
        },
        {
          "id": "doctors",
          "title": "Doctors in the territory",
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan/doctors?terrId={{terrId}}",
            "as": "mio",
            "mobileHeader": true
          },
          "capture": {
            "doctorId": "data[0].value"
          },
          "expect": {
            "envelopeStatusCode": 200,
            "nonEmpty": "data"
          },
          "critical": true
        },
        {
          "id": "chambers",
          "title": "That doctor's chambers",
          "note": "The chamber must belong to the chosen doctor AND sit in the plan territory.",
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan/chambers?doctorId={{doctorId}}&terrId={{terrId}}",
            "as": "mio",
            "mobileHeader": true
          },
          "capture": {
            "chamberId": "data[0].value"
          },
          "expect": {
            "envelopeStatusCode": 200,
            "nonEmpty": "data"
          },
          "critical": true
        },
        {
          "id": "submit",
          "title": "Submit the month",
          "note": "A plan is unique per employee + territory + month, so a same-month re-run correctly answers 400 — use the 'average' scenario to see that.",
          "request": {
            "method": "POST",
            "path": "/api/v1/app/visitplan",
            "as": "mio",
            "mobileHeader": true,
            "bodyFrom": "visitPlanMonth",
            "bodyArgs": {
              "terrId": "{{terrId}}",
              "year": "{{year}}",
              "month": "{{month}}",
              "dates": 3,
              "perDate": 1,
              "pool": [
                {
                  "reportingPlaceId": "{{rpId}}",
                  "doctorId": "{{doctorId}}",
                  "chamberId": "{{chamberId}}"
                }
              ]
            }
          },
          "capture": {
            "planId": "data.id",
            "planStatus": "data.status",
            "planVersion": "data.currentVersion"
          },
          "expect": {
            "httpStatus": 200,
            "envelopeStatusCode": 200
          },
          "critical": true
        },
        {
          "id": "am-inbox",
          "title": "AM inbox — pending for me",
          "note": "Empty here means the PGroup has no APPROVAL_PROCESS row for OperationType 5, so the plan auto-approved.",
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan?pendingForMe=true&page=1&pageSize=20",
            "as": "am",
            "mobileHeader": true
          },
          "expect": {
            "envelopeStatusCode": 200
          }
        },
        {
          "id": "detail",
          "title": "Open the plan calendar",
          "requiresVars": [
            "planId"
          ],
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan/{{planId}}",
            "as": "mio",
            "mobileHeader": true
          },
          "expect": {
            "envelopeStatusCode": 200
          }
        },
        {
          "id": "approve",
          "title": "AM approves",
          "requiresVars": [
            "planId"
          ],
          "request": {
            "method": "PUT",
            "path": "/api/v1/app/visitplan/{{planId}}/approval",
            "as": "am",
            "mobileHeader": true,
            "body": {
              "status": 1
            }
          },
          "capture": {
            "approvedVersion": "data.approvedVersion"
          },
          "expect": {
            "envelopeStatusCode": 200
          }
        },
        {
          "id": "by-date",
          "title": "by-date serves the approved version",
          "note": "by-date always reads APPROVED_VERSION, never a pending edit.",
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan/by-date?date={{firstOfMonth}}",
            "as": "mio",
            "mobileHeader": true
          },
          "expect": {
            "envelopeStatusCode": 200
          }
        }
      ]
    },
    {
      "id": "vp.average.amend-and-duplicate",
      "module": "visit-plan",
      "path": "average",
      "title": "Duplicate month, then amend back to Pending",
      "description": "The two things that actually happen day to day: someone re-submits a month that already exists, and someone amends an approved plan — which returns it to Pending while by-date keeps serving the last approved version.",
      "requires": [
        "mio"
      ],
      "writes": true,
      "inputs": [
        {
          "name": "year",
          "label": "Plan year",
          "type": "number",
          "default": "{{year}}",
          "hint": "the plan's PLAN_YEAR"
        },
        {
          "name": "month",
          "label": "Plan month",
          "type": "select",
          "default": "{{month}}",
          "hint": "one plan per employee + territory + month",
          "options": [
            {
              "value": 1,
              "label": "January"
            },
            {
              "value": 2,
              "label": "February"
            },
            {
              "value": 3,
              "label": "March"
            },
            {
              "value": 4,
              "label": "April"
            },
            {
              "value": 5,
              "label": "May"
            },
            {
              "value": 6,
              "label": "June"
            },
            {
              "value": 7,
              "label": "July"
            },
            {
              "value": 8,
              "label": "August"
            },
            {
              "value": 9,
              "label": "September"
            },
            {
              "value": 10,
              "label": "October"
            },
            {
              "value": 11,
              "label": "November"
            },
            {
              "value": 12,
              "label": "December"
            }
          ]
        }
      ],
      "steps": [
        {
          "id": "territories",
          "title": "Territory picker",
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan/territories",
            "as": "mio",
            "mobileHeader": true
          },
          "capture": {
            "terrId": "data[0].value"
          },
          "expect": {
            "envelopeStatusCode": 200,
            "nonEmpty": "data"
          },
          "critical": true
        },
        {
          "id": "my-plans",
          "title": "My plans this month",
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan?year={{year}}&month={{month}}&page=1&pageSize=20",
            "as": "mio",
            "mobileHeader": true
          },
          "capture": {
            "existingPlanId": "data.items[0].id"
          },
          "expect": {
            "envelopeStatusCode": 200
          }
        },
        {
          "id": "reporting-places",
          "title": "Approved reporting places",
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan/reporting-places?terrId={{terrId}}",
            "as": "mio",
            "mobileHeader": true
          },
          "capture": {
            "rpId": "data[0].value"
          },
          "expect": {
            "envelopeStatusCode": 200,
            "nonEmpty": "data"
          },
          "critical": true
        },
        {
          "id": "doctors",
          "title": "Doctors",
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan/doctors?terrId={{terrId}}",
            "as": "mio",
            "mobileHeader": true
          },
          "capture": {
            "doctorId": "data[0].value"
          },
          "expect": {
            "envelopeStatusCode": 200,
            "nonEmpty": "data"
          },
          "critical": true
        },
        {
          "id": "chambers",
          "title": "Chambers",
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan/chambers?doctorId={{doctorId}}&terrId={{terrId}}",
            "as": "mio",
            "mobileHeader": true
          },
          "capture": {
            "chamberId": "data[0].value"
          },
          "expect": {
            "envelopeStatusCode": 200,
            "nonEmpty": "data"
          },
          "critical": true
        },
        {
          "id": "duplicate-month",
          "title": "400 — a plan already exists for this month",
          "note": "Only meaningful once a plan exists for this employee, territory and month. On a clean database this step will pass with 200 instead.",
          "request": {
            "method": "POST",
            "path": "/api/v1/app/visitplan",
            "as": "mio",
            "mobileHeader": true,
            "bodyFrom": "visitPlanMonth",
            "bodyArgs": {
              "terrId": "{{terrId}}",
              "year": "{{year}}",
              "month": "{{month}}",
              "dates": 2,
              "perDate": 1,
              "pool": [
                {
                  "reportingPlaceId": "{{rpId}}",
                  "doctorId": "{{doctorId}}",
                  "chamberId": "{{chamberId}}"
                }
              ]
            }
          },
          "expect": {
            "httpStatus": 200,
            "envelopeStatus": "ValidationError",
            "envelopeStatusCode": 400
          }
        },
        {
          "id": "amend",
          "title": "Amend the existing plan → Pending",
          "note": "An MIO amend always returns the whole plan to Pending and creates a new approval row.",
          "requiresVars": [
            "existingPlanId"
          ],
          "request": {
            "method": "PUT",
            "path": "/api/v1/app/visitplan/{{existingPlanId}}",
            "as": "mio",
            "mobileHeader": true,
            "bodyFrom": "visitPlanMonth",
            "bodyArgs": {
              "terrId": "{{terrId}}",
              "year": "{{year}}",
              "month": "{{month}}",
              "dates": 2,
              "perDate": 1,
              "pool": [
                {
                  "reportingPlaceId": "{{rpId}}",
                  "doctorId": "{{doctorId}}",
                  "chamberId": "{{chamberId}}"
                }
              ]
            }
          },
          "expect": {
            "envelopeStatusCode": 200
          }
        },
        {
          "id": "by-date-after-amend",
          "title": "by-date still serves the approved version",
          "note": "The amend above is pending, so the day's visits must not change.",
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan/by-date?date={{firstOfMonth}}",
            "as": "mio",
            "mobileHeader": true
          },
          "expect": {
            "envelopeStatusCode": 200
          }
        }
      ]
    },
    {
      "id": "vp.worst.status-matrix",
      "module": "visit-plan",
      "path": "worst",
      "title": "Error matrix — 400 / 401 / 404",
      "description": "Every validation rule the plan service enforces, plus auth and not-found. Nothing here writes successfully, so it is safe to run repeatedly.",
      "requires": [
        "mio"
      ],
      "writes": true,
      "inputs": [
        {
          "name": "year",
          "label": "Plan year",
          "type": "number",
          "default": "{{year}}",
          "hint": "the plan's PLAN_YEAR"
        },
        {
          "name": "month",
          "label": "Plan month",
          "type": "select",
          "default": "{{month}}",
          "hint": "one plan per employee + territory + month",
          "options": [
            {
              "value": 1,
              "label": "January"
            },
            {
              "value": 2,
              "label": "February"
            },
            {
              "value": 3,
              "label": "March"
            },
            {
              "value": 4,
              "label": "April"
            },
            {
              "value": 5,
              "label": "May"
            },
            {
              "value": 6,
              "label": "June"
            },
            {
              "value": 7,
              "label": "July"
            },
            {
              "value": 8,
              "label": "August"
            },
            {
              "value": 9,
              "label": "September"
            },
            {
              "value": 10,
              "label": "October"
            },
            {
              "value": 11,
              "label": "November"
            },
            {
              "value": 12,
              "label": "December"
            }
          ]
        }
      ],
      "steps": [
        {
          "id": "401-no-token",
          "title": "401 — no token (Mobile)",
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan/territories",
            "as": "none",
            "mobileHeader": true
          },
          "expect": {
            "httpStatus": 200,
            "envelopeStatus": "Error",
            "envelopeStatusCode": 401
          }
        },
        {
          "id": "401-garbage",
          "title": "401 — malformed bearer token",
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan/territories",
            "as": "garbage",
            "mobileHeader": true
          },
          "expect": {
            "httpStatus": 200,
            "envelopeStatusCode": 401
          }
        },
        {
          "id": "404-plan",
          "title": "404 — unknown plan id",
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan/999999999",
            "as": "mio",
            "mobileHeader": true
          },
          "expect": {
            "httpStatus": 200,
            "envelopeStatus": "Error",
            "envelopeStatusCode": 404
          }
        },
        {
          "id": "404-approval",
          "title": "404 — approval on an unknown plan",
          "request": {
            "method": "PUT",
            "path": "/api/v1/app/visitplan/999999999/approval",
            "as": "mio",
            "mobileHeader": true,
            "body": {
              "status": 1
            }
          },
          "expect": {
            "httpStatus": 200,
            "envelopeStatusCode": 404
          }
        },
        {
          "id": "400-terrid-missing",
          "title": "400 — lookup without terrId",
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan/reporting-places?terrId=",
            "as": "mio",
            "mobileHeader": true
          },
          "expect": {
            "httpStatus": 200,
            "envelopeStatus": "ValidationError",
            "envelopeStatusCode": 400
          }
        },
        {
          "id": "400-doctors-no-terrid",
          "title": "400 — doctors without terrId",
          "request": {
            "method": "GET",
            "path": "/api/v1/app/visitplan/doctors?terrId=",
            "as": "mio",
            "mobileHeader": true
          },
          "expect": {
            "httpStatus": 200,
            "envelopeStatusCode": 400
          }
        },
        {
          "id": "400-month-out-of-range",
          "title": "400 — month 13",
          "request": {
            "method": "POST",
            "path": "/api/v1/app/visitplan",
            "as": "mio",
            "mobileHeader": true,
            "body": {
              "terrId": "X",
              "planYear": "{{year}}",
              "planMonth": 13,
              "dates": [
                {
                  "visitDate": "{{firstOfMonth}}",
                  "visits": [
                    {
                      "reportingPlaceId": 1,
                      "doctorId": 1,
                      "chamberId": 1
                    }
                  ]
                }
              ]
            }
          },
          "expect": {
            "httpStatus": 200,
            "envelopeStatus": "ValidationError",
            "envelopeStatusCode": 400
          }
        },
        {
          "id": "400-no-dates",
          "title": "400 — no dates at all",
          "request": {
            "method": "POST",
            "path": "/api/v1/app/visitplan",
            "as": "mio",
            "mobileHeader": true,
            "body": {
              "terrId": "X",
              "planYear": "{{year}}",
              "planMonth": "{{month}}",
              "dates": []
            }
          },
          "expect": {
            "httpStatus": 200,
            "envelopeStatusCode": 400
          }
        },
        {
          "id": "400-date-outside-month",
          "title": "400 — a date outside the plan month",
          "request": {
            "method": "POST",
            "path": "/api/v1/app/visitplan",
            "as": "mio",
            "mobileHeader": true,
            "body": {
              "terrId": "X",
              "planYear": "{{year}}",
              "planMonth": "{{month}}",
              "dates": [
                {
                  "visitDate": "2020-01-15",
                  "visits": [
                    {
                      "reportingPlaceId": 1,
                      "doctorId": 1,
                      "chamberId": 1
                    }
                  ]
                }
              ]
            }
          },
          "expect": {
            "httpStatus": 200,
            "envelopeStatusCode": 400
          }
        },
        {
          "id": "400-unknown-reporting-place",
          "title": "400 — reporting place that is not approved / not in territory",
          "request": {
            "method": "POST",
            "path": "/api/v1/app/visitplan",
            "as": "mio",
            "mobileHeader": true,
            "body": {
              "terrId": "X",
              "planYear": "{{year}}",
              "planMonth": "{{month}}",
              "dates": [
                {
                  "visitDate": "{{firstOfMonth}}",
                  "visits": [
                    {
                      "reportingPlaceId": 999999999,
                      "doctorId": 1,
                      "chamberId": 1
                    }
                  ]
                }
              ]
            }
          },
          "expect": {
            "httpStatus": 200,
            "envelopeStatusCode": 400
          }
        },
        {
          "id": "400-approval-invalid-status",
          "title": "400 — approval status must be 1 or 3",
          "request": {
            "method": "PUT",
            "path": "/api/v1/app/visitplan/1/approval",
            "as": "mio",
            "mobileHeader": true,
            "body": {
              "status": 2
            }
          },
          "expect": {
            "httpStatus": 200,
            "envelopeStatus": "ValidationError",
            "envelopeStatusCode": 400
          }
        },
        {
          "id": "400-decline-no-reason",
          "title": "400 — decline without a reason",
          "note": "Declining requires a reason; approving does not.",
          "request": {
            "method": "PUT",
            "path": "/api/v1/app/visitplan/1/approval",
            "as": "mio",
            "mobileHeader": true,
            "body": {
              "status": 3
            }
          },
          "expect": {
            "httpStatus": 200,
            "envelopeStatusCode": 400
          }
        }
      ]
    }
  ]
}
